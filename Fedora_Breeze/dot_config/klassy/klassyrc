[ButtonBehaviour]
ShowCloseOutlineOnHoverActive=false
ShowCloseOutlineOnHoverInactive=false
ShowOutlineOnHoverActive=false
ShowOutlineOnHoverInactive=false

[ButtonColors]
ButtonOverrideColorsInactiveClose={"OutlineHover":["AccentButtonFocus",0],"OutlineNormal":["AccentButtonFocus",0],"OutlinePress":["AccentButtonFocus",0]}
ButtonOverrideColorsInactiveMaximize={"OutlineHover":["AccentButtonFocus",0],"OutlineNormal":["AccentButtonFocus",0],"OutlinePress":["AccentButtonFocus",0]}
ButtonOverrideColorsInactiveMinimize={"OutlineHover":["AccentButtonFocus",0],"OutlineNormal":["AccentButtonFocus",0],"OutlinePress":["AccentButtonFocus",0]}
CloseButtonIconColorActive=AsSelected
CloseButtonIconColorInactive=AsSelected

[ButtonSizing]
ScaleBackgroundPercent=125

[Global]
LookAndFeelSet=org.fedoraproject.fedoradark.desktop
RefreshedConfig=6.5.3

[Style]
ButtonGradient=true
MenuItemDrawStrongFocus=false

[TitleBarSpacing]
TitleBarLeftMargin=4
TitleBarRightMargin=4

[Windeco]
ButtonIconStyle=StyleFluent
ButtonShape=ShapeSmallCircle
DrawBorderOnMaximizedWindows=true
WindowCornerRadius=8

[WindowOutlineStyle]
WindowOutlineAccentColorOpacityActive=100
WindowOutlineShadowColorOpacity=25
WindowOutlineSnapToWholePixel=false
WindowOutlineStyleActive=WindowOutlineAccentColor
WindowOutlineThickness=2
