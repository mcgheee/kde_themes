theme = FedoraBreeze
font-family = FiraCode Nerd Font Mono
font-synthetic-style = true
font-size = 14
adjust-cursor-thickness = 3
cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true
cursor-opacity = .9
#background-opacity = .95
background-opacity-cells = true
background-blur = true
selection-clear-on-copy = false
mouse-hide-while-typing = true
scroll-to-bottom = keystroke, no-output
linux-cgroup = always
linux-cgroup-hard-fail = false
gtk-tabs-location = top
gtk-toolbar-style = raised-border
desktop-notifications = true

# Custom shaders
#custom-shader-animation = true
custom-shader-animation = always

# https://github.com/sahaj-b/ghostty-cursor-shaders
#custom-shader = shaders/cursor_sweep.glsl
#custom-shader = shaders/cursor_tail.glsl
custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/ripple_cursor.glsl
#custom-shader = shaders/ripple_rectangle_cursor.glsl
#custom-shader = shaders/rectangle_boom_cursor.glsl
#custom-shader = shaders/sonic_boom_cursor.glsl

